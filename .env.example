# keirin.jp scraping
KEIRIN_USER_AGENT=Mozilla/5.0 (keirin-ai research; +https://github.com/Tower2007/keirin-ai)
KEIRIN_REQUEST_DELAY_SEC=0.8

# データ保存先 (省略時はプロジェクト直下の data/)
# 別 PC とのデータ共有に Google Drive 等を使う場合に指定。
# 例: DATA_DIR=G:\マイドライブ\keirin-ai\data
# DATA_DIR=

# Supabase (project: keirin-ai) — Phase 2 移行用、Phase 1 では未使用
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Gmail SMTP (将来の通知用)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO=
